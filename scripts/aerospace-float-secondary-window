#!/usr/bin/env zsh

set -u

bundle_id="${1:-}"
window_id="${AEROSPACE_WINDOW_ID:-${2:-}}"

if [[ -z "$bundle_id" || -z "$window_id" ]]; then
    exit 0
fi

if [[ -x /opt/homebrew/bin/aerospace ]]; then
    aerospace_bin=/opt/homebrew/bin/aerospace
elif [[ -x /usr/local/bin/aerospace ]]; then
    aerospace_bin=/usr/local/bin/aerospace
elif (( $+commands[aerospace] )); then
    aerospace_bin=$commands[aerospace]
else
    exit 0
fi

for _ in {1..6}; do
    window_ids="$(
        "$aerospace_bin" list-windows \
            --monitor all \
            --app-bundle-id "$bundle_id" \
            --format '%{window-id}' 2>/dev/null
    )" || exit 0

    current_window_seen=false

    while IFS= read -r candidate_id; do
        [[ -z "$candidate_id" ]] && continue

        if [[ "$candidate_id" == "$window_id" ]]; then
            current_window_seen=true
        else
            # A different window already belongs to the app, so this new
            # window is secondary and should stay floating.
            exit 0
        fi
    done <<< "$window_ids"

    if [[ "$current_window_seen" == true ]]; then
        "$aerospace_bin" layout --window-id "$window_id" tiling >/dev/null 2>&1
        exit 0
    fi

    sleep 0.05
done
