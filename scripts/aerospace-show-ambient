#!/bin/sh

set -eu

find_aerospace() {
    if command -v aerospace >/dev/null 2>&1; then
        command -v aerospace
    elif [ -x /opt/homebrew/bin/aerospace ]; then
        printf '/opt/homebrew/bin/aerospace\n'
    elif [ -x /usr/local/bin/aerospace ]; then
        printf '/usr/local/bin/aerospace\n'
    fi
}

aerospace_bin=$(find_aerospace)
[ -n "$aerospace_bin" ] || exit 0

monitor_count=$(
    "$aerospace_bin" list-monitors --format '%{monitor-id}' |
        /usr/bin/awk 'NF { count++ } END { print count + 0 }'
)

# Workspace 10 falls back to DELL in a two-display setup. In that situation,
# leave the current workspace alone instead of covering the work display.
[ "$monitor_count" -ge 3 ] || exit 0

"$aerospace_bin" workspace 10
"$aerospace_bin" focus-monitor dell
